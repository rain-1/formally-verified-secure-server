# Example systemd unit. The server already confines itself (Landlock + seccomp); this adds
# an independent outer layer (namespaces, capabilities, resource limits) in case that layer fails.
[Unit]
Description=Verified static HTTPS server
After=network-online.target

[Service]
# Binds low ports via a capability, then the server drops to the numeric uid/gid itself.
ExecStart=/usr/local/bin/server-static --root /srv/www --port 443 --bind 0.0.0.0 \
    --tls-chain /etc/secure-web-server/chain.bin --tls-key /etc/secure-web-server/key.bin --uid 65534 --gid 65534
Restart=always
RestartSec=2
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitNOFILE=8192
LimitCORE=0
MemoryMax=512M
TasksMax=4
# Key files readable only by root (read before the privilege drop)
# chmod 600 /etc/secure-web-server/key.bin

[Install]
WantedBy=multi-user.target
